<script>
"use strict";
const LOGO = { markBeige:"data:image/png;base64,", wordBeige:"data:image/png;base64,",
               markTeal:"data:image/png;base64,", wordTeal:"data:image/png;base64,",
               markPurple:"data:image/png;base64,", wordPurple:"data:image/png;base64," };

const AR = "٠١٢٣٤٥٦٧٨٩";
const ar = s => String(s).replace(/[0-9]/g, d => AR[+d]);
const money = n => ar((+n || 0).toFixed(2).replace(".", "٫"));
const esc = s => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const $ = id => document.getElementById(id);
const dmy = iso => { if (!iso) return "—"; const [y,m,d] = iso.split("-"); return ar(`${d}/${m}/${y}`); };
const digits = s => String(s || "").replace(/[٠-٩]/g, d => AR.indexOf(d)).replace(/\D/g, "");
const waNum = p => { const d = digits(p); return d.startsWith("966") ? d : d.replace(/^0/, "966"); };

const DEFAULTS = {
  legalName:"مؤسسة علي حنيف اليامي", phone:"+966 50 647 1735", mail:"washdkor@gmail.com",
  city:"الخرج — حي المنتزه، المملكة العربية السعودية",
  vatNo:"312490621200003", crNo:"7041532446",
  showVat:true, showCr:true, vatEnabled:false, vatRate:15
};
const S = () => DB.settings;
const DEPTS = {
  elec:  { label:"كهرباء وسباكة", tag:"كهرباء · سباكة · صيانة", note:"صيانة طارئة ٢٤ ساعة", color:"#0F4C5C",
           quick:["تمديد كهرباء","تغيير لوحة كهربائية","إصلاح تسريب","تسليك مجاري","تركيب سخان","تركيب إنارة","كشف تسريبات","تركيب خلاط"] },
  decor: { label:"ديكور", tag:"ديكور · تشطيبات", note:"من التصميم حتى التسليم", color:"#3D0A3D",
           quick:["تصميم داخلي","جبس بورد","دهانات","ورق جدران","تركيب باركيه","مجالس","مطابخ","واجهات داخلية"] }
};

/* ---------- الختم ---------- */
function stampSVG(deptKey, size){
  const c = DEPTS[deptKey].color, id = "sp" + Math.random().toString(36).slice(2, 7);
  const mark = deptKey === "decor" ? LOGO.markPurple : LOGO.markTeal;
  return `<svg viewBox="0 0 200 200" ${size ? `width="${size}" height="${size}"` : ""}
    xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
    <defs>
      <path id="${id}t" d="M100,100 m-77,0 a77,77 0 1,1 154,0" fill="none"/>
      <path id="${id}b" d="M100,100 m77,0 a77,77 0 1,1 -154,0" fill="none"/>
    </defs>
    <circle cx="100" cy="100" r="95" fill="none" stroke="${c}" stroke-width="3.6"/>
    <circle cx="100" cy="100" r="86" fill="none" stroke="${c}" stroke-width="1.2"/>
    <text font-family="Readex Pro, sans-serif" font-size="16" font-weight="600" fill="${c}" letter-spacing="1.5">
      <textPath href="#${id}t" xlink:href="#${id}t" startOffset="50%" text-anchor="middle">مؤسسة وشـى</textPath></text>
    <text font-family="IBM Plex Sans Arabic, sans-serif" font-size="11.5" fill="${c}" letter-spacing="1">
      <textPath href="#${id}b" xlink:href="#${id}b" startOffset="50%" text-anchor="middle">الخرج — المملكة العربية السعودية</textPath></text>
    <image href="${mark}" xlink:href="${mark}" x="74" y="46" width="52" height="54"/>
    <text x="100" y="124" text-anchor="middle" font-family="IBM Plex Sans Arabic, sans-serif"
          font-size="13.5" font-weight="700" fill="${c}">${DEPTS[deptKey].label}</text>
    <line x1="62" y1="134" x2="138" y2="134" stroke="${c}" stroke-width="1.4"/>
    <text x="100" y="150" text-anchor="middle" font-family="IBM Plex Sans Arabic, sans-serif"
          font-size="10.5" fill="${c}">ختم معتمد</text>
  </svg>`;
}

/* ---------- التفقيط ---------- */
function tafqit(n){
  n = Math.round((+n || 0) * 100) / 100;
  const riyals = Math.floor(n), hal = Math.round((n - riyals) * 100);
  const ones = ["","واحد","اثنان","ثلاثة","أربعة","خمسة","ستة","سبعة","ثمانية","تسعة","عشرة","أحد عشر","اثنا عشر","ثلاثة عشر","أربعة عشر","خمسة عشر","ستة عشر","سبعة عشر","ثمانية عشر","تسعة عشر"];
  const tens = ["","","عشرون","ثلاثون","أربعون","خمسون","ستون","سبعون","ثمانون","تسعون"];
  const huns = ["","مائة","مائتان","ثلاثمائة","أربعمائة","خمسمائة","ستمائة","سبعمائة","ثمانمائة","تسعمائة"];
  const u = x => { const p = [];
    if (x >= 100) { p.push(huns[Math.floor(x/100)]); x %= 100; }
    if (x >= 20) { const o = x % 10; p.push(o ? ones[o] + " و" + tens[Math.floor(x/10)] : tens[Math.floor(x/10)]); }
    else if (x > 0) p.push(ones[x]);
    return p.join(" و"); };
  const conv = x => { if (x === 0) return "صفر";
    const p = [], th = Math.floor(x/1000), r = x % 1000;
    if (th === 1) p.push("ألف"); else if (th === 2) p.push("ألفان");
    else if (th >= 3 && th <= 10) p.push(u(th) + " آلاف"); else if (th > 10) p.push(u(th) + " ألفًا");
    if (r) p.push(u(r));
    return p.join(" و"); };
  let s = "فقط " + conv(riyals) + " ريال";
  if (hal) s += " و" + u(hal) + " هللة";
  return s + " لا غير";
}

/* ---------- التخزين: كل شيء يُحفظ تلقائيًا ---------- */
const KEY = "washy:data:v3";
let DB = { invoices: [], clients: [], draft: null, settings: Object.assign({}, DEFAULTS) };
let saveTimer = null, saveFailed = false;

async function readKey(k){
  try {
    if (window.storage) { const r = await window.storage.get(k); return r && r.value; }
    return localStorage.getItem(k);
  } catch(e){ return null; }
}
async function load(){
  try {
    let raw = await readKey(KEY);
    if (raw) {
      DB = Object.assign({ invoices:[], clients:[], draft:null, settings:{} }, JSON.parse(raw));
    } else {
      const v2 = await readKey("washy:data:v2");
      const v1 = localStorage.getItem("washy:invoices");
      if (v2) { const o = JSON.parse(v2); DB.invoices = o.invoices || []; DB.draft = o.draft || null; }
      else if (v1) DB.invoices = JSON.parse(v1);
      DB.clients = [];
    }
    DB.settings = Object.assign({}, DEFAULTS, DB.settings || {});
    if (/الازدهار/.test(DB.settings.city || "")) DB.settings.city = DEFAULTS.city;
    rebuildClients();
    persist();
  } catch(e){}
}
function rebuildClients(){
  const keep = DB.clients || [];
  DB.clients = [];
  DB.invoices.forEach(i => upsertClient(i.client, i.dept));
  keep.forEach(o => { const ex = DB.clients.find(c => c.key === o.key); if (ex) ex.site = ex.site || o.site; });
}
function persist(){
  clearTimeout(saveTimer);
  saveTimer = setTimeout(async () => {
    const s = JSON.stringify(DB);
    try {
      if (window.storage) await window.storage.set(KEY, s);
      else localStorage.setItem(KEY, s);
      saveFailed = false;
    } catch(e){ if (!saveFailed) { saveFailed = true; toast("تعذّر الحفظ — مساحة المتصفح ممتلئة"); } }
  }, 350);
}

/* ---------- العملاء ---------- */
function clientKey(c, d){ return (d || "elec") + "|" + (digits(c.phone) || ("n:" + (c.name || "").trim())); }
function upsertClient(c, d){
  if (!c || !(c.name || c.phone)) return null;
  const k = clientKey(c, d);
  let ex = DB.clients.find(x => x.key === k);
  if (!ex) { ex = { key:k, dept:d || "elec", id:"c_" + Date.now() + Math.random().toString(36).slice(2,5),
                    created:new Date().toISOString().slice(0,10) }; DB.clients.push(ex); }
  ex.name = c.name || ex.name; ex.phone = c.phone || ex.phone; ex.site = c.site || ex.site;
  return ex;
}
const clientInvoices = c => DB.invoices.filter(i => clientKey(i.client, i.dept) === c.key);

/* ---------- حالة العرض ---------- */
let current = null, dept = "elec", view = "invoices", activeClient = null;

const blank = (preset, kind) => {
  const k = kind || "inv", today = new Date();
  const valid = new Date(today.getTime() + 14 * 864e5).toISOString().slice(0,10);
  return {
    id:"inv_" + Date.now(), kind:k, no:nextNo(dept, k), dept,
    date:today.toISOString().slice(0,10),
    status: k === "quote" ? "draft" : "paid",
    client: preset || { name:"", phone:"", site:"" },
    items:[{ d:"", q:1, p:"" }], disc:0, paid:0, pay:"نقدًا", notes:"",
    validUntil: k === "quote" ? valid : "",
    vatRate: S().vatEnabled ? +S().vatRate || 15 : 0
  };
};
const NOPFX = { elec:"ك", decor:"د" };
const KINDS = {
  inv:   { one:"فاتورة", newBtn:"فاتورة جديدة", noLbl:"رقم الفاتورة (تلقائي)",
           title:"فاتـورة", en:"INVOICE", vatTitle:"فاتورة ضريبية", vatEn:"SIMPLIFIED TAX INVOICE",
           statuses:[["paid","مدفوعة"],["partial","دفعة مقدمة"],["due","غير محصّلة"]],
           k1:"إجمالي هذا الشهر", k2:"فواتير الشهر", k3:"غير محصّل" },
  quote: { one:"عرض سعر", newBtn:"عرض سعر جديد", noLbl:"رقم العرض (تلقائي)",
           title:"عرض سعر", en:"QUOTATION", vatTitle:"عرض سعر", vatEn:"QUOTATION",
           statuses:[["draft","مبدئي"],["sent","مُرسل للعميل"],["accepted","مقبول"],["rejected","مرفوض"]],
           k1:"إجمالي عروض الشهر", k2:"عروض الشهر", k3:"بانتظار الرد" }
};
const kindOf = i => i.kind === "quote" ? "quote" : "inv";
let listKind = "inv";
function nextNo(d, kind){
  const y = new Date().getFullYear(), k = kind || "inv";
  const pfx = (k === "quote" ? "ع" : "") + (NOPFX[d] || "ك");
  const nums = DB.invoices.filter(i => i.dept === d && kindOf(i) === k)
    .map(i => +String(i.no).split("-").pop()).filter(n => !isNaN(n));
  return `${pfx}-${y}-${String((nums.length ? Math.max(...nums) : 0) + 1).padStart(3,"0")}`;
}
function calc(inv){
  const sub = inv.items.reduce((s,i) => s + (+i.q || 0) * (+i.p || 0), 0);
  const net = Math.max(0, sub - (+inv.disc || 0));
  const rate = +inv.vatRate || 0;
  const vat = Math.round(net * rate) / 100;
  const total = net + vat;
  const paid = kindOf(inv) === "quote" ? 0 : (+inv.paid || 0);
  return { sub, net, vat, rate, total, due: Math.max(0, total - paid) };
}
function toast(msg){
  const t = $("toast"); t.textContent = msg; t.classList.add("on");
  clearTimeout(t._t); t._t = setTimeout(() => t.classList.remove("on"), 2400);
}
function setDept(d){
  dept = d;
  document.body.classList.toggle("decor", d === "decor");
  document.querySelectorAll("#segDept button").forEach(b => b.classList.toggle("on", b.dataset.d === d));
  document.querySelector('meta[name=theme-color]').content = DEPTS[d].color;
  if (current) {
    current.dept = d;
    if (!DB.invoices.some(i => i.id === current.id)) { current.no = nextNo(d, kindOf(current)); $("fNo").value = current.no; }
    renderQuick(); autosave();
  } else if (view === "invoices") renderInvoices();
  else if (view === "clients") renderClients();
}

/* ---------- التنقّل ---------- */
function show(v){
  view = v;
  ["viewInvoices","viewClients","viewClient","viewForm","viewSettings"].forEach(id => $(id).classList.add("hide"));
  const el = $({ invoices:"viewInvoices", quotes:"viewInvoices", clients:"viewClients",
                 client:"viewClient", form:"viewForm", settings:"viewSettings" }[v]);
  el.classList.remove("hide"); el.classList.remove("view"); void el.offsetWidth; el.classList.add("view");
  const form = v === "form", sub = v === "client" || v === "settings";
  $("tabs").classList.toggle("hide", form || sub);
  $("newBtn").classList.toggle("hide", form);
  $("saveBtn").classList.toggle("hide", !form);
  $("backBtn").classList.toggle("hide", !(form || sub));
  document.querySelectorAll("#tabs button").forEach(b => b.classList.toggle("on", b.dataset.t === v));
  window.scrollTo({ top:0, behavior:"instant" in document.body.style ? "instant" : "auto" });
}

/* ---------- قائمة الفواتير ---------- */
function statusLabel(i){
  const k = kindOf(i), row = KINDS[k].statuses.find(x => x[0] === i.status);
  return row ? row[1] : "";
}
function renderInvoices(){
  const K = KINDS[listKind], q = $("qInv").value.trim().toLowerCase();
  const mineAll = DB.invoices.filter(i => i.dept === dept && kindOf(i) === listKind);
  const arr = mineAll
    .filter(i => !q || (i.no + " " + i.client.name + " " + i.client.phone).toLowerCase().includes(q))
    .sort((a,b) => (b.date + b.no).localeCompare(a.date + a.no));

  $("qInv").placeholder = listKind === "quote"
    ? "ابحث برقم العرض أو اسم العميل" : "ابحث برقم الفاتورة أو اسم العميل";
  $("kMonth").textContent = K.k1; $("kCount").textContent = K.k2; $("kDue").textContent = K.k3;

  const m = new Date().toISOString().slice(0,7);
  const mine = mineAll.filter(i => (i.date || "").startsWith(m));
  $("sMonth").textContent = money(mine.reduce((s,i) => s + calc(i).total, 0)) + " ر.س";
  $("sCount").textContent = ar(mine.length);
  $("sDue").textContent = listKind === "quote"
    ? money(mineAll.filter(i => i.status === "draft" || i.status === "sent")
        .reduce((s,i) => s + calc(i).total, 0)) + " ر.س"
    : money(mineAll.filter(i => i.status !== "paid").reduce((s,i) => s + calc(i).due, 0)) + " ر.س";

  const d = DB.draft && kindOf(DB.draft) === listKind && DB.draft.dept === dept ? DB.draft : null;
  $("draftBox").innerHTML = d
    ? `<button class="rowcard stagger" id="resume" style="border-color:var(--accent)">
         <span class="dia" style="background:var(--accent)"></span>
         <span><span class="ttl">${K.one} غير مكتمل</span>
         <span class="sub" style="display:block">${esc(d.client.name) || "بدون اسم"} — تابع من حيث وقفت</span></span>
         <span class="amt">${money(calc(d).total)} ر.س</span></button>` : "";
  if (d) $("resume").onclick = () => openInvoice(d, true);

  $("listInv").innerHTML = arr.length ? arr.map((i,n) => {
    const q2 = kindOf(i) === "quote";
    const flag = q2 ? (i.status !== "accepted") : (i.status !== "paid");
    const expired = q2 && i.validUntil && i.validUntil < new Date().toISOString().slice(0,10)
                    && i.status !== "accepted";
    return `<button class="rowcard stagger" data-id="${i.id}" style="animation-delay:${Math.min(n,10)*32}ms">
      <span class="dia" style="background:${DEPTS[i.dept].color}"></span>
      <span>
        <span class="ttl">${K.one} <bdi>${ar(i.no)}</bdi></span>
        <span class="sub" style="display:block">${esc(i.client.name) || "بدون اسم"}</span>
        <span class="meta"><bdi>${dmy(i.date)}</bdi> · ${DEPTS[i.dept].label}
          ${flag ? `<span class="pill due">${statusLabel(i)}</span>` : ""}
          ${expired ? `<span class="pill due">منتهي</span>` : ""}
          ${i.convertedTo ? `<span class="pill">صارت فاتورة</span>` : ""}</span>
      </span>
      <span class="amt">${money(calc(i).total)} ر.س</span>
    </button>`; }).join("")
    : `<div class="empty"><img src="${LOGO.markTeal}" alt="">
        ${q ? `ما فيه ${K.one} يطابق البحث.`
            : `ما عندك ${listKind === "quote" ? "عروض أسعار" : "فواتير"} في قسم ${DEPTS[dept].label}.<br>ابدأ من زر «${K.newBtn}» تحت.`}</div>`;

  $("listInv").querySelectorAll("[data-id]").forEach(el =>
    el.onclick = () => openInvoice(DB.invoices.find(x => x.id === el.dataset.id)));
}

/* ---------- قائمة العملاء ---------- */
function renderClients(){
  const q = $("qCli").value.trim().toLowerCase();
  const arr = DB.clients
    .filter(c => (c.dept || "elec") === dept)
    .filter(c => !q || ((c.name || "") + " " + (c.phone || "")).toLowerCase().includes(q))
    .map(c => ({ c, inv: clientInvoices(c) }))
    .sort((a,b) => b.inv.length - a.inv.length);

  $("listCli").innerHTML = arr.length ? arr.map(({ c, inv }, n) => `
    <button class="rowcard stagger" data-k="${esc(c.key)}" style="animation-delay:${Math.min(n,10)*32}ms">
      <span class="dia" style="background:var(--brand)"></span>
      <span>
        <span class="ttl">${esc(c.name) || "بدون اسم"}</span>
        <span class="sub ltr" style="display:block">${esc(c.phone) || "—"}</span>
        <span class="meta">${esc(c.site) || "بدون موقع"}</span>
      </span>
      <span class="amt">${money(inv.filter(i => kindOf(i) === "inv").reduce((s,i) => s + calc(i).total, 0))} ر.س
        <small>${ar(inv.filter(i => kindOf(i) === "inv").length)} فاتورة${
          inv.some(i => kindOf(i) === "quote") ? ` · ${ar(inv.filter(i => kindOf(i) === "quote").length)} عرض` : ""}</small></span>
    </button>`).join("")
    : `<div class="empty"><img src="${LOGO.markTeal}" alt="">
        ${q ? "ما فيه عميل بهذا الاسم."
            : `ما عندك عملاء في قسم ${DEPTS[dept].label}.<br>كل عميل ينحفظ تلقائيًا مع أول فاتورة في قسمه.`}</div>`;

  $("listCli").querySelectorAll("[data-k]").forEach(el =>
    el.onclick = () => openClient(DB.clients.find(c => c.key === el.dataset.k)));
}

function openClient(c){
  activeClient = c;
  const inv = clientInvoices(c);
  $("cvName").textContent = c.name || "بدون اسم";
  $("cvPhone").textContent = c.phone || "—";
  $("cvSite").textContent = c.site || "—";
  $("cvTotal").textContent = money(inv.filter(i => kindOf(i) === "inv")
    .reduce((s,i) => s + calc(i).total, 0)) + " ر.س";
  $("cvList").innerHTML = inv.length ? inv.sort((a,b) => b.date.localeCompare(a.date)).map((i,n) => `
    <button class="rowcard stagger" data-id="${i.id}" style="animation-delay:${Math.min(n,10)*32}ms">
      <span class="dia" style="background:${DEPTS[i.dept].color}"></span>
      <span><span class="ttl">${KINDS[kindOf(i)].one} <bdi>${ar(i.no)}</bdi></span>
        <span class="meta" style="display:block"><bdi>${dmy(i.date)}</bdi> · ${DEPTS[i.dept].label}
          ${kindOf(i) === "quote" ? `<span class="pill">${statusLabel(i)}</span>` : ""}</span></span>
      <span class="amt">${money(calc(i).total)} ر.س</span></button>`).join("")
    : `<div class="empty">ما له فواتير أو عروض بعد.</div>`;
  $("cvList").querySelectorAll("[data-id]").forEach(el =>
    el.onclick = () => {
      const d = DB.invoices.find(x => x.id === el.dataset.id);
      listKind = kindOf(d); $("newBtn").textContent = KINDS[listKind].newBtn;
      openInvoice(d);
    });
  show("client");
}

/* ---------- نموذج الفاتورة ---------- */
function openInvoice(inv, isDraft){
  current = JSON.parse(JSON.stringify(inv));
  current._draft = !!isDraft;
  setDept(current.dept);
  $("fNo").value = current.no; $("fDate").value = current.date;
  $("cName").value = current.client.name; $("cPhone").value = current.client.phone; $("cSite").value = current.client.site;
  const K0 = KINDS[kindOf(current)];
  $("fStatus").innerHTML = K0.statuses.map(([v,l]) => `<option value="${v}">${l}</option>`).join("");
  $("fStatus").value = current.status;
  $("fDisc").value = current.disc; $("fPaid").value = current.paid; $("fPay").value = current.pay;
  $("fValid").value = current.validUntil || "";
  $("fNotes").value = current.notes;
  $("fNo").readOnly = true; $("noLock").textContent = "تعديل";
  applyKindUI();
  renderRows(); renderQuick(); updateTotals();
  const saved = DB.invoices.some(i => i.id === current.id);
  $("delBtn").style.visibility = saved ? "visible" : "hidden";
  $("delBtn").textContent = "حذف " + KINDS[kindOf(current)].one;
  $("convBtn").classList.toggle("hide", !(saved && kindOf(current) === "quote" && !current.convertedTo));
  show("form");
}

function applyKindUI(){
  const q = kindOf(current) === "quote", K = KINDS[q ? "quote" : "inv"];
  $("lblNo").textContent = K.noLbl;
  $("wrapPaid").classList.toggle("hide", q);
  $("wrapPay").classList.toggle("hide", q);
  $("wrapValid").classList.toggle("hide", !q);
  $("newBtn").textContent = K.newBtn;
}

function renderRows(){
  $("rows").innerHTML = current.items.map((it,n) => `
    <div class="item">
      <div class="desc"><input value="${esc(it.d)}" data-f="d" data-i="${n}" placeholder="وصف العمل أو القطعة"></div>
      <div class="qp">
        <div class="fl"><span>الكمية</span><input class="num" value="${it.q}" data-f="q" data-i="${n}" type="number" inputmode="decimal" min="0" step="any"></div>
        <div class="fl"><span>السعر</span><input class="num" value="${it.p}" data-f="p" data-i="${n}" type="number" inputmode="decimal" min="0" step="any" placeholder="٠٫٠٠"></div>
      </div>
      <div class="tot" data-t="${n}">${money((+it.q || 0) * (+it.p || 0))}</div>
      <button class="rm" data-del="${n}" aria-label="حذف البند">×</button>
    </div>`).join("");

  $("rows").querySelectorAll("input").forEach(inp => {
    inp.oninput = () => {
      const it = current.items[+inp.dataset.i];
      it[inp.dataset.f] = inp.value;
      $("rows").querySelector(`[data-t="${inp.dataset.i}"]`).textContent = money((+it.q || 0) * (+it.p || 0));
      updateTotals(); autosave();
    };
  });
  $("rows").querySelectorAll("[data-del]").forEach(b => {
    b.onclick = () => {
      current.items.splice(+b.dataset.del, 1);
      if (!current.items.length) current.items.push({ d:"", q:1, p:"" });
      renderRows(); updateTotals(); autosave();
    };
  });
}
function renderQuick(){
  $("quick").innerHTML = DEPTS[dept].quick.map(t => `<button class="chip">${t}</button>`).join("");
  $("quick").querySelectorAll("button").forEach((b,i) => {
    b.onclick = () => {
      const t = DEPTS[dept].quick[i], empty = current.items.find(x => !x.d);
      if (empty) empty.d = t; else current.items.push({ d:t, q:1, p:"" });
      renderRows(); updateTotals(); autosave();
    };
  });
}
function updateTotals(){
  current.disc = +$("fDisc").value || 0; current.paid = +$("fPaid").value || 0;
  const t = calc(current);
  $("tSub").textContent = money(t.sub);
  $("tNet").textContent = money(t.net);
  $("vatLine").classList.toggle("hide", !t.rate);
  $("vatLbl").textContent = `ضريبة القيمة المضافة ${ar(t.rate)}٪`;
  $("tVat").textContent = money(t.vat);
  $("tDue").textContent = money(t.due) + " ر.س";
  $("tWords").textContent = t.due > 0 ? tafqit(t.due) : "";
}
function readForm(){
  current.no = $("fNo").value.trim(); current.date = $("fDate").value; current.status = $("fStatus").value;
  current.client = { name:$("cName").value.trim(), phone:$("cPhone").value.trim(), site:$("cSite").value.trim() };
  current.disc = +$("fDisc").value || 0; current.paid = +$("fPaid").value || 0;
  current.pay = $("fPay").value; current.notes = $("fNotes").value.trim(); current.dept = dept;
  current.validUntil = $("fValid").value;
  if (kindOf(current) === "quote") current.paid = 0;
}
function cleanItems(inv){
  const items = inv.items.filter(i => String(i.d).trim() || +i.p > 0);
  return Object.assign({}, inv, { items: items.length ? items : [{ d:"—", q:1, p:0 }] });
}
/* الحفظ التلقائي: أي تعديل يُخزَّن كمسودة فورًا */
function autosave(){
  if (!current) return;
  readForm();
  const saved = DB.invoices.find(i => i.id === current.id);
  if (saved) { Object.assign(saved, JSON.parse(JSON.stringify(current))); delete saved._draft; DB.draft = null; }
  else DB.draft = JSON.parse(JSON.stringify(current));
  persist();
}
["fNo","fDate","fStatus","cName","cPhone","cSite","fDisc","fPaid","fPay","fValid","fNotes"].forEach(id => {
  $(id).addEventListener("input", () => { if (id === "fDisc" || id === "fPaid") updateTotals(); autosave(); });
  $(id).addEventListener("change", autosave);
});

/* ---------- اقتراح العملاء ---------- */
function suggestClients(){
  const v = $("cName").value.trim().toLowerCase();
  const hits = v.length < 1 ? [] : DB.clients
    .filter(c => (c.dept || "elec") === dept)
    .filter(c => (c.name || "").toLowerCase().includes(v) && c.name.toLowerCase() !== v).slice(0,5);
  if (!hits.length) { $("sugg").classList.add("hide"); return; }
  $("sugg").innerHTML = hits.map(c => `<button data-k="${esc(c.key)}">${esc(c.name)}
    <small class="ltr">${esc(c.phone || "")}</small></button>`).join("");
  $("sugg").classList.remove("hide");
  $("sugg").querySelectorAll("button").forEach(b => b.onclick = () => {
    const c = DB.clients.find(x => x.key === b.dataset.k);
    $("cName").value = c.name; $("cPhone").value = c.phone || ""; $("cSite").value = c.site || "";
    $("sugg").classList.add("hide"); autosave(); toast("تم جلب بيانات العميل");
  });
}
$("cName").addEventListener("input", suggestClients);
$("cName").addEventListener("blur", () => setTimeout(() => $("sugg").classList.add("hide"), 180));

/* ---------- ورقة الطباعة ---------- */
function buildSheet(inv){
  const t = calc(inv), D = DEPTS[inv.dept], isQ = kindOf(inv) === "quote", K = KINDS[isQ ? "quote" : "inv"];
  const word = inv.dept === "decor" ? LOGO.wordPurple : LOGO.wordTeal;
  const rows = inv.items.map((it,n) => `<tr>
      <td>${ar(n+1)}</td><td class="d">${esc(it.d)}</td>
      <td>${ar(it.q)}</td><td>${money(it.p)}</td>
      <td>${money((+it.q || 0) * (+it.p || 0))}</td></tr>`).join("");

  $("sheet").innerHTML = `
    <div class="ph">
      <div><img src="${word}" alt="وشى"><div class="dept">${D.tag}</div></div>
      <div class="t"><b>${t.rate ? K.vatTitle : K.title}</b>
        <small>${t.rate ? K.vatEn : K.en}</small></div>
    </div>
    <div class="rule"></div>
    <div class="legal">
      <span><b>${esc(S().legalName)}</b></span>
      ${S().showVat && S().vatNo ? `<span>الرقم الضريبي: <b class="ltr">${esc(S().vatNo)}</b></span>` : ""}
      ${S().showCr && S().crNo ? `<span>السجل التجاري: <b class="ltr">${esc(S().crNo)}</b></span>` : ""}
    </div>
    <div class="meta">
      <div><span class="k">${isQ ? "رقم العرض" : "رقم الفاتورة"}</span><span class="v"><bdi>${ar(inv.no)}</bdi></span></div>
      <div><span class="k">التاريخ</span><span class="v"><bdi>${dmy(inv.date)}</bdi></span></div>
      ${isQ
        ? `<div><span class="k">صالح حتى</span><span class="v"><bdi>${inv.validUntil ? dmy(inv.validUntil) : "—"}</bdi></span></div>`
        : `<div><span class="k">طريقة الدفع</span><span class="v">${esc(inv.pay)}</span></div>`}
    </div>
    <div class="st">بيانات العميل</div>
    <div class="cl">
      <div><span class="k">الاسم</span><span class="v">${esc(inv.client.name) || "—"}</span></div>
      <div><span class="k">الجوال</span><span class="v ltr">${esc(inv.client.phone) || "—"}</span></div>
      <div><span class="k">موقع العمل</span><span class="v">${esc(inv.client.site) || "—"}</span></div>
    </div>
    <div class="st">تفاصيل الأعمال</div>
    <table>
      <thead><tr><th style="width:8mm">م</th><th style="text-align:right">وصف العمل / القطعة</th>
        <th style="width:13mm">الكمية</th><th style="width:21mm">سعر الوحدة</th><th style="width:23mm">الإجمالي</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>
    <div class="bt">
      <div class="l"><span class="k">ملاحظات</span><span class="v">${esc(inv.notes) || "—"}</span>
        <div class="words">${tafqit(t.due)}</div></div>
      <div class="r">
        <div><span>المجموع</span><b>${money(t.sub)}</b></div>
        <div><span>خصم</span><b>${money(inv.disc)}</b></div>
        ${t.rate ? `<div><span>ضريبة القيمة المضافة ${ar(t.rate)}٪</span><b>${money(t.vat)}</b></div>` : ""}
        ${isQ ? "" : `<div><span>دفعة مقدمة</span><b>${money(inv.paid)}</b></div>`}
        <div class="g"><span>${isQ ? "إجمالي العرض" : "الإجمالي المستحق"}</span><span>${money(t.due)} ر.س</span></div>
      </div>
    </div>
    ${isQ ? `<div class="warn">هذا عرض سعر وليس فاتورة · الأسعار سارية حتى ${inv.validUntil ? dmy(inv.validUntil) : "التاريخ الموضح"} · التنفيذ يبدأ بعد الموافقة.</div>` : ""}
    <div class="sg"><div class="stamp">${stampSVG(inv.dept)}</div></div>
    <div class="ft"><span>${esc(S().mail)}</span>
      <span style="margin-inline-start:auto"><b class="ltr">${esc(S().phone)}</b> · ${esc(S().city)} · ${D.note}</span></div>`;
}

/* ---------- أزرار ---------- */
$("segDept").onclick = e => { const b = e.target.closest("button"); if (b) setDept(b.dataset.d); };
$("tabs").onclick = e => { const b = e.target.closest("button"); if (!b) return;
  const t = b.dataset.t;
  if (t === "clients") { renderClients(); show("clients"); return; }
  listKind = t === "quotes" ? "quote" : "inv";
  $("newBtn").textContent = KINDS[listKind].newBtn;
  $("qInv").value = ""; renderInvoices(); show(t);
};
$("qInv").oninput = renderInvoices;
$("qCli").oninput = renderClients;
$("newBtn").onclick = () => openInvoice(blank(null, listKind), true);
function backToList(){
  renderInvoices();
  show(listKind === "quote" ? "quotes" : "invoices");
}
$("backBtn").onclick = () => {
  if (view === "form" || view === "settings") backToList();
  else { renderClients(); show("clients"); }
};
$("addRow").onclick = () => { current.items.push({ d:"", q:1, p:"" }); renderRows(); };
$("quickBtn").onclick = () => $("quick").classList.toggle("hide");

$("saveBtn").onclick = () => {
  readForm();
  if (!current.client.name && !current.client.phone) { toast("اكتب اسم العميل أو جواله"); $("cName").focus(); return; }
  const clean = cleanItems(current); delete clean._draft;
  const i = DB.invoices.findIndex(x => x.id === clean.id);
  if (i >= 0) DB.invoices[i] = clean; else DB.invoices.push(clean);
  upsertClient(clean.client, clean.dept);
  DB.draft = null; persist();
  stampAnim(clean.dept);
  listKind = kindOf(clean);
  $("newBtn").textContent = KINDS[listKind].newBtn;
  setTimeout(() => { toast(`تم حفظ ${KINDS[listKind].one} والعميل`); backToList(); }, 380);
};
$("delBtn").onclick = () => {
  const one = KINDS[kindOf(current)].one;
  if (!confirm(`حذف ${one} نهائيًا؟`)) return;
  DB.invoices = DB.invoices.filter(x => x.id !== current.id);
  DB.draft = null; persist(); toast(`تم حذف ${one}`); backToList();
};

/* ---------- تحويل عرض سعر إلى فاتورة ---------- */
$("convBtn").onclick = () => {
  readForm();
  const src = cleanItems(current);
  if (!confirm("تحويل هذا العرض إلى فاتورة بنفس البنود والأسعار؟")) return;
  const inv = JSON.parse(JSON.stringify(src));
  inv.id = "inv_" + Date.now(); inv.kind = "inv";
  inv.no = nextNo(inv.dept, "inv");
  inv.date = new Date().toISOString().slice(0,10);
  inv.status = "paid"; inv.paid = 0; inv.pay = "نقدًا"; inv.validUntil = "";
  inv.fromQuote = src.no;
  inv.vatRate = S().vatEnabled ? +S().vatRate || 15 : src.vatRate || 0;
  delete inv.convertedTo;
  DB.invoices.push(inv);
  const q = DB.invoices.find(x => x.id === src.id);
  if (q) { q.convertedTo = inv.no; q.status = "accepted"; }
  DB.draft = null; persist();
  listKind = "inv"; $("newBtn").textContent = KINDS.inv.newBtn;
  toast("تم إنشاء فاتورة من العرض");
  openInvoice(inv);
};
$("printBtn").onclick = () => { readForm(); buildSheet(cleanItems(current)); setTimeout(() => window.print(), 90); };
$("waBtn").onclick = () => {
  readForm();
  const inv = cleanItems(current), t = calc(inv);
  const lines = inv.items.map(i => `• ${i.d} — ${ar(i.q)} × ${money(i.p)} = ${money((+i.q||0)*(+i.p||0))}`).join("\n");
  const isQ = kindOf(inv) === "quote";
  const msg = `مؤسسة وشى — ${DEPTS[inv.dept].label}\n${isQ ? "عرض سعر" : "فاتورة"} رقم ${ar(inv.no)} بتاريخ ${dmy(inv.date)}\n`
    + `العميل: ${inv.client.name}\n\n${lines}\n\nالمجموع: ${money(t.sub)} ر.س`
    + (inv.disc ? `\nخصم: ${money(inv.disc)} ر.س` : "")
    + (t.rate ? `\nضريبة القيمة المضافة ${ar(t.rate)}٪: ${money(t.vat)} ر.س` : "")
    + (!isQ && inv.paid ? `\nدفعة مقدمة: ${money(inv.paid)} ر.س` : "")
    + `\n${isQ ? "إجمالي العرض" : "المستحق"}: ${money(t.due)} ر.س`
    + (isQ && inv.validUntil ? `\nالعرض صالح حتى ${dmy(inv.validUntil)}` : "")
    + `\n\n${S().phone} · ${S().mail}`;
  window.open(`https://wa.me/${waNum(inv.client.phone)}?text=${encodeURIComponent(msg)}`, "_blank");
};
const cvPreset = () => ({ name:activeClient.name, phone:activeClient.phone || "", site:activeClient.site || "" });
$("cvNew").onclick = () => { listKind = "inv"; openInvoice(blank(cvPreset(), "inv"), true); };
$("cvQuote").onclick = () => { listKind = "quote"; openInvoice(blank(cvPreset(), "quote"), true); };
$("cvCall").onclick = () => location.href = "tel:" + (activeClient.phone || "");
$("cvWa").onclick = () => window.open(`https://wa.me/${waNum(activeClient.phone)}`, "_blank");

/* ---------- الإعدادات ---------- */
const SET_FIELDS = { stName:"legalName", stPhone:"phone", stMail:"mail", stCity:"city",
                     stVatNo:"vatNo", stCrNo:"crNo" };
function renderSettings(){
  Object.entries(SET_FIELDS).forEach(([id,k]) => $(id).value = S()[k] || "");
  [["swVat","showVat"],["swCr","showCr"],["swVatCalc","vatEnabled"]]
    .forEach(([id,k]) => $(id).setAttribute("aria-pressed", S()[k] ? "true" : "false"));
}
Object.keys(SET_FIELDS).forEach(id => $(id).addEventListener("input", () => {
  DB.settings[SET_FIELDS[id]] = $(id).value.trim(); persist();
}));
document.querySelectorAll(".sw").forEach(b => b.onclick = () => {
  const k = b.dataset.k, on = !S()[k];
  DB.settings[k] = on; b.setAttribute("aria-pressed", on ? "true" : "false"); persist();
  if (k === "vatEnabled") {
    if (current) { current.vatRate = on ? (+S().vatRate || 15) : 0; updateTotals(); autosave(); }
    toast(on ? "تم تفعيل ضريبة ١٥٪ على الفواتير الجديدة" : "تم إيقاف احتساب الضريبة");
  } else toast(on ? "تم إظهار الرقم في الفاتورة" : "تم إخفاء الرقم — محفوظ وترجّعه وقت ما تبي");
});
$("gearBtn").onclick = () => { renderSettings(); show("settings"); };
$("noLock").onclick = () => {
  const ro = $("fNo").readOnly;
  $("fNo").readOnly = !ro; $("noLock").textContent = ro ? "تلقائي" : "تعديل";
  if (ro) $("fNo").focus();
  else if (!DB.invoices.some(i => i.id === current.id)) { current.no = nextNo(dept); $("fNo").value = current.no; autosave(); }
};
$("expBtn").onclick = () => {
  const blob = new Blob([JSON.stringify(DB, null, 2)], { type:"application/json" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = `washy-backup-${new Date().toISOString().slice(0,10)}.json`;
  a.click(); URL.revokeObjectURL(a.href); toast("تم تصدير النسخة");
};
$("impBtn").onclick = () => $("impFile").click();
$("impFile").onchange = e => {
  const f = e.target.files[0]; if (!f) return;
  const r = new FileReader();
  r.onload = () => {
    try {
      const o = JSON.parse(r.result);
      if (!Array.isArray(o.invoices)) throw 0;
      if (!confirm("استبدال البيانات الحالية بالنسخة المستوردة؟")) return;
      DB.invoices = o.invoices; DB.draft = o.draft || null;
      DB.settings = Object.assign({}, DEFAULTS, o.settings || {});
      DB.clients = o.clients || []; rebuildClients(); persist();
      renderSettings(); renderInvoices(); toast("تم استيراد النسخة");
    } catch(err){ toast("الملف غير صالح"); }
    e.target.value = "";
  };
  r.readAsText(f);
};

/* ---------- حركة الختم عند الحفظ ---------- */
function stampAnim(d){
  const el = document.createElement("div");
  el.className = "saved"; el.innerHTML = stampSVG(d);
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 800);
}

/* ---------- الإقلاع ---------- */
(async function init(){
  await load();
  $("fDate").value = new Date().toISOString().slice(0,10);
  renderInvoices(); show("invoices");
})();
</script>
</body>
</html>
