<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0F4C5C">
<title>فواتير وشى</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ===================== الرموز ===================== */
:root{
  --teal:#0F4C5C; --amber:#D98B00; --sky:#1B8A9C; --ink:#17262C; --silver:#E8EDEF;
  --purple:#3D0A3D; --beige:#EDC9AF;
  --brand:var(--teal); --accent:var(--amber); --soft:#E4EBEE; --paper:#F2F5F6;
  --line:#C7D4D9; --muted:#5A6E76; --field:#fff;
  --r:12px; --sp:16px;
  --ease:cubic-bezier(.22,.9,.3,1);
  --safe:env(safe-area-inset-bottom, 0px);
}
body.decor{ --brand:var(--purple); --accent:#A06B2E; --soft:#EFE3D8; --paper:#F7F1EA;
            --line:#DCCBBB; --muted:#7A6350; --ink:#2E2118; }

*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{-webkit-text-size-adjust:100%}
body{font-family:"IBM Plex Sans Arabic",system-ui,sans-serif;background:var(--paper);color:var(--ink);
     transition:background .4s var(--ease)}
h1,h2,h3,.dis{font-family:"Readex Pro","IBM Plex Sans Arabic",sans-serif;font-weight:600}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
input,select,textarea{width:100%;padding:12px 13px;border:1px solid var(--line);border-radius:10px;
  background:var(--field);transition:border-color .2s,box-shadow .2s}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--brand);
  box-shadow:0 0 0 3px color-mix(in srgb, var(--brand) 14%, transparent)}
:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
bdi,.ltr{unicode-bidi:isolate}
.ltr{direction:ltr;display:inline-block}
.hide{display:none !important}

/* ===================== الترويسة ===================== */
.top{background:var(--brand);padding:12px 16px;display:flex;align-items:center;gap:12px;
     position:sticky;top:0;z-index:30;transition:background .4s var(--ease)}
.top img.mark{height:30px}
.top img.word{height:23px;display:block}
.top .sub{font-size:10.5px;color:rgba(255,255,255,.6);margin-top:3px}
.seg{margin-inline-start:auto;display:flex;background:rgba(255,255,255,.14);border-radius:999px;padding:3px;font-size:12.5px}
.seg button{padding:7px 13px;border-radius:999px;color:#fff;opacity:.75;white-space:nowrap;
            transition:.25s var(--ease)}
.seg button.on{background:var(--beige);color:var(--brand);opacity:1;font-weight:700}
.strip{height:3px;background:var(--accent)}
.wrap{max-width:940px;margin:0 auto;padding:16px 14px calc(96px + var(--safe))}

/* ===================== بطاقات ===================== */
.card{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:16px;margin-bottom:14px}
.card h2{font-size:14.5px;color:var(--brand);margin-bottom:14px;display:flex;align-items:center;gap:9px}
.card h2::before{content:"";width:8px;height:8px;background:var(--accent);transform:rotate(45deg);flex:none}
label{display:block;font-size:12px;color:var(--muted);margin-bottom:6px;font-weight:500}
.grid{display:grid;gap:12px}
.g2{grid-template-columns:1fr 1fr}
.g3{grid-template-columns:1fr 1fr 1fr}
@media(max-width:660px){.g2,.g3{grid-template-columns:1fr}}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}

.btn{background:var(--brand);color:#fff;padding:13px 18px;border-radius:10px;font-weight:600;font-size:14px;
     transition:transform .12s var(--ease),filter .2s;display:inline-flex;align-items:center;gap:7px;justify-content:center}
.btn:active{transform:scale(.96)}
.btn.acc{background:var(--accent)}
.btn.ghost{background:#fff;border:1px solid var(--line);color:var(--ink)}
.btn.danger{background:#fff;border:1px solid #E3C3C3;color:#A93B40}
.btn.sm{padding:9px 13px;font-size:13px;font-weight:500}
.chip{background:var(--soft);color:var(--brand);border-radius:999px;padding:8px 14px;font-size:13px;
      transition:transform .12s var(--ease)}
.chip:active{transform:scale(.94)}

/* ===================== لوحة الأرقام ===================== */
.sum{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}
.sum div{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:13px}
.sum .k{font-size:11px;color:var(--muted)}
.sum .v{font-family:"Readex Pro";font-size:17px;color:var(--brand);margin-top:4px;white-space:nowrap}
@media(max-width:520px){.sum{grid-template-columns:1fr 1fr}.sum div:first-child{grid-column:1/-1}}

/* ===================== القوائم ===================== */
.rowcard{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid var(--line);
  border-radius:var(--r);background:#fff;margin-bottom:9px;width:100%;text-align:start;
  transition:transform .14s var(--ease),box-shadow .2s}
.rowcard:active{transform:scale(.985)}
.rowcard .dia{width:11px;height:11px;transform:rotate(45deg);flex:none}
.rowcard .ttl{font-family:"Readex Pro";font-size:14px;color:var(--brand)}
.rowcard .sub{font-size:12.5px;margin-top:2px}
.rowcard .meta{font-size:11.5px;color:var(--muted);margin-top:2px}
.rowcard .amt{margin-inline-start:auto;font-family:"Readex Pro";font-size:15px;white-space:nowrap;text-align:end}
.rowcard .amt small{display:block;font-size:10.5px;color:var(--muted);font-family:"IBM Plex Sans Arabic";margin-top:3px}
.pill{font-size:10px;padding:3px 8px;border-radius:999px;background:var(--soft);color:var(--brand)}
.pill.due{background:#FBEEDA;color:#8A5A00}
.empty{text-align:center;padding:52px 18px;color:var(--muted);font-size:14px;line-height:2}
.empty img{width:52px;opacity:.45;margin-bottom:12px;animation:float 3.4s var(--ease) infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
.search{margin-bottom:12px}
.sectitle{font-size:12px;color:var(--muted);margin:18px 4px 8px}

/* ===================== بنود الفاتورة ===================== */
.ihead{display:grid;grid-template-columns:1fr 68px 96px 92px 34px;gap:8px;padding:0 4px 8px;
  font-size:11.5px;color:var(--muted)}
.item{display:grid;grid-template-columns:1fr 68px 96px 92px 34px;gap:8px;align-items:center;
  padding:8px 4px;border-top:1px solid var(--line)}
.item .qp{display:contents}
.item .fl span{display:none}
.item .tot{font-family:"Readex Pro";font-size:13.5px;color:var(--brand);text-align:center}
.item .rm{color:#A93B40;font-size:20px;line-height:1;padding:6px}
.item input{padding:11px 10px}
.item .num{text-align:center}
@media(max-width:660px){
  .ihead{display:none}
  .item{grid-template-columns:1fr auto;gap:8px;padding:12px 0;position:relative}
  .item .desc{grid-column:1/-1}
  .item .qp{grid-column:1;display:grid;grid-template-columns:1fr 1.3fr;gap:8px}
  .item .fl span{display:block}
  .item .tot{grid-column:2;min-width:84px;text-align:end;font-size:15px}
  .item .rm{position:absolute;top:6px;left:0}
  .item .fl{position:relative}
  .item .fl span{position:absolute;top:-8px;inset-inline-start:10px;background:#fff;padding:0 5px;
    font-size:10px;color:var(--muted)}
}

/* ===================== المجاميع ===================== */
.totals{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.totline{display:flex;justify-content:space-between;padding:11px 12px;background:var(--paper);
  border:1px solid var(--line);border-radius:10px;font-size:14px}
.grand{grid-column:1/-1;background:var(--brand);color:#fff;padding:16px;border-radius:10px;
  display:flex;justify-content:space-between;align-items:center;font-family:"Readex Pro";font-size:18px;
  overflow:hidden;position:relative}
.grand::after{content:"";position:absolute;inset-block:0;inset-inline-start:-40%;width:40%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.14),transparent);animation:sheen 5s var(--ease) infinite}
@keyframes sheen{0%,60%{inset-inline-start:-40%}100%{inset-inline-start:120%}}
.tafqit{grid-column:1/-1;font-size:12.5px;color:var(--muted);text-align:center;line-height:1.8}

/* ===================== الاقتراحات ===================== */
.sugg{position:relative}
.sugglist{position:absolute;inset-inline:0;top:calc(100% + 6px);background:#fff;border:1px solid var(--line);
  border-radius:10px;box-shadow:0 12px 28px rgba(15,76,92,.13);z-index:15;overflow:hidden;
  animation:pop .18s var(--ease)}
.sugglist button{display:block;width:100%;text-align:start;padding:11px 13px;font-size:13.5px;
  border-bottom:1px solid var(--soft)}
.sugglist button:last-child{border:0}
.sugglist button small{color:var(--muted);font-size:11.5px;margin-inline-start:6px}
@keyframes pop{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}

/* ===================== الشريط السفلي ===================== */
.bar{position:fixed;bottom:0;inset-inline:0;background:rgba(255,255,255,.94);backdrop-filter:blur(10px);
  border-top:1px solid var(--line);padding:10px 14px calc(10px + var(--safe));display:flex;gap:9px;
  justify-content:center;z-index:30}
.bar .btn{flex:1;max-width:230px}
.tabs{display:flex;gap:6px;flex:1;max-width:340px;justify-content:center}
.tabs button{flex:1;padding:9px 6px;border-radius:10px;font-size:11.5px;color:var(--muted);
  display:flex;flex-direction:column;align-items:center;gap:5px;transition:.2s}
.tabs button .d{width:9px;height:9px;transform:rotate(45deg);background:currentColor;opacity:.35;transition:.25s var(--ease)}
.tabs button.on{color:var(--brand);font-weight:600}
.tabs button.on .d{opacity:1;transform:rotate(45deg) scale(1.25)}

.toast{position:fixed;bottom:calc(84px + var(--safe));inset-inline:0;margin:auto;width:max-content;max-width:88%;
  background:var(--ink);color:#fff;padding:11px 20px;border-radius:999px;font-size:13px;z-index:60;
  opacity:0;transform:translateY(12px);transition:.3s var(--ease);pointer-events:none}
.toast.on{opacity:1;transform:none}

/* ===================== الحركة ===================== */
.view{animation:viewIn .34s var(--ease) both}
@keyframes viewIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.stagger{animation:itemIn .38s var(--ease) both}
@keyframes itemIn{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:none}}
.saved{position:fixed;inset:0;display:grid;place-items:center;z-index:70;pointer-events:none}
.saved svg{width:180px;animation:stamp .75s var(--ease) both}
@keyframes stamp{
  0%{opacity:0;transform:scale(2.1) rotate(-24deg)}
  45%{opacity:.95;transform:scale(.96) rotate(-11deg)}
  60%{transform:scale(1.03) rotate(-13deg)}
  75%{opacity:.95;transform:scale(1) rotate(-12deg)}
  100%{opacity:0;transform:scale(1) rotate(-12deg)}
}
@media(prefers-reduced-motion:reduce){
  *,*::after{animation:none !important;transition:none !important}
}

/* ===================== الإعدادات ===================== */
.gear{color:#fff;font-size:19px;opacity:.85;padding:8px;margin-inline-start:6px;line-height:1}
.setrow{display:flex;align-items:center;gap:12px;justify-content:space-between;padding:13px 0;
  border-top:1px solid var(--line)}
.setrow:first-of-type{border-top:0}
.setrow .txt{flex:1;min-width:0}
.setrow .txt b{font-size:13.5px;font-weight:600;display:block}
.setrow .txt small{font-size:11.5px;color:var(--muted);display:block;margin-top:3px}
.sw{width:50px;height:29px;border-radius:999px;background:var(--line);position:relative;flex:none;
  transition:background .25s var(--ease)}
.sw i{position:absolute;top:3px;inset-inline-start:3px;width:23px;height:23px;border-radius:50%;
  background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.22);transition:inset-inline-start .25s var(--ease)}
.sw[aria-pressed="true"]{background:var(--brand)}
.sw[aria-pressed="true"] i{inset-inline-start:24px}
.note{font-size:12px;color:var(--muted);line-height:1.9;background:var(--paper);
  border:1px solid var(--line);border-radius:10px;padding:12px}
.lockrow{display:flex;gap:8px;align-items:center}
.lockrow input{flex:1}
.lockrow input[readonly]{background:var(--paper);color:var(--muted)}
.lockbtn{border:1px solid var(--line);border-radius:10px;padding:12px 12px;font-size:12px;color:var(--muted);
  white-space:nowrap;background:#fff}

/* ===================== ورقة الطباعة A5 ===================== */
#sheet{display:none}
@media print{
  body{background:#fff}
  .top,.strip,.wrap,.bar,.toast,.saved{display:none !important}
  #sheet{display:block !important}
  @page{size:148mm 210mm;margin:8mm 9mm}
}
#sheet{width:130mm;color:#15242A;font-size:9pt;line-height:1.55}
#sheet .ph{display:flex;align-items:flex-end;padding-bottom:2mm}
#sheet .ph img{height:9mm}
#sheet .ph .dept{font-size:7.5pt;color:#4E6068;margin-top:1.5mm}
#sheet .ph .t{margin-inline-start:auto;text-align:left}
#sheet .ph .t b{font-family:"Readex Pro";font-size:16pt;color:var(--brand);display:block;line-height:1}
#sheet .ph .t small{font-size:7pt;color:#7A8C93;letter-spacing:1px}
#sheet .rule{border-top:1.2mm solid var(--accent);margin-bottom:2.5mm}
#sheet .legal{display:flex;flex-wrap:wrap;gap:1mm 5mm;font-size:7.5pt;color:#3E5057;margin-bottom:2mm}
#sheet .legal b{color:var(--brand);font-weight:600}
#sheet .meta{display:flex;gap:6mm;padding-bottom:2.4mm;border-bottom:.3mm solid #B9C6CA;margin-bottom:2.6mm}
#sheet .meta>div{flex:1}
#sheet .k{color:#5A6E76;font-size:7.5pt;display:block;font-weight:500}
#sheet .v{font-weight:600;color:#0F1E24}
#sheet .st{font-family:"Readex Pro";font-size:9.5pt;color:var(--brand);
  border-bottom:.5mm solid var(--brand);padding-bottom:1mm;margin:0 0 2.5mm}
#sheet .cl{display:flex;gap:6mm;margin-bottom:3mm}
#sheet .cl>div{flex:1}
#sheet table{width:100%;border-collapse:collapse;font-size:9pt;margin-bottom:3mm}
#sheet thead th{color:var(--brand);font-size:8.5pt;font-weight:700;padding:0 1.5mm 1.5mm;
  border-bottom:.6mm solid var(--brand)}
#sheet tbody td{border:.25mm solid #B9C6CA;height:6.2mm;padding:.6mm 1.5mm;text-align:center;color:#0F1E24}
#sheet tbody td.d{text-align:right}
#sheet .bt{display:flex;gap:6mm;margin-bottom:2mm}
#sheet .bt .l{flex:1;font-size:8.5pt}
#sheet .bt .r{width:60mm}
#sheet .bt .r div{display:flex;justify-content:space-between;border-bottom:.25mm solid #B9C6CA;padding:1.2mm 1mm}
#sheet .bt .r .g{border:0;border-top:.8mm solid var(--brand);border-bottom:.8mm solid var(--brand);
  font-family:"Readex Pro";font-size:11pt;color:var(--brand);padding:1.8mm 1mm;margin-top:1mm}
#sheet .words{margin-top:2mm;color:#3E5057;font-weight:500}
#sheet .sg{text-align:center;margin-top:5mm}
#sheet .sg .ln{flex:1;border-top:.35mm solid #7A8C93;padding-top:1.5mm}
#sheet .sg .stamp{flex:1;text-align:center}
#sheet .sg .stamp svg{width:26mm;height:26mm;transform:rotate(-9deg)}
#sheet .warn{font-size:7.5pt;color:#5A6E76;margin-top:1.5mm}
#sheet .ft{margin-top:3mm;border-top:1mm solid var(--accent);padding-top:1.6mm;display:flex;
  font-size:8pt;color:#3E5057;gap:4mm}
#sheet .ft b{color:var(--brand)}
</style>
</head>
<body>

<header class="top">
  <img class="mark" src="data:image/png;base64," alt="">
  <div>
    <img class="word" src="data:image/png;base64," alt="وشى">
    <div class="sub">نظام الفواتير</div>
  </div>
  <div class="seg" id="segDept">
    <button data-d="elec" class="on">كهرباء وسباكة</button>
    <button data-d="decor">ديكور</button>
  </div>
  <button class="gear" id="gearBtn" aria-label="الإعدادات">⚙</button>
</header>
<div class="strip"></div>

<main class="wrap">

  <!-- ============ الفواتير ============ -->
  <section id="viewInvoices">
    <div class="sum">
      <div><div class="k" id="kMonth">إجمالي هذا الشهر</div><div class="v" id="sMonth">٠ ر.س</div></div>
      <div><div class="k" id="kCount">فواتير الشهر</div><div class="v" id="sCount">٠</div></div>
      <div><div class="k" id="kDue">غير محصّل</div><div class="v" id="sDue">٠ ر.س</div></div>
    </div>
    <div id="draftBox"></div>
    <input class="search" id="qInv" placeholder="ابحث برقم الفاتورة أو اسم العميل">
    <div id="listInv"></div>
  </section>

  <!-- ============ العملاء ============ -->
  <section id="viewClients" class="hide">
    <input class="search" id="qCli" placeholder="ابحث باسم العميل أو جواله">
    <div id="listCli"></div>
  </section>

  <!-- ============ ملف عميل ============ -->
  <section id="viewClient" class="hide">
    <div class="card">
      <h2 id="cvName">العميل</h2>
      <div class="grid g3">
        <div><label>الجوال</label><div class="ltr" id="cvPhone">—</div></div>
        <div><label>الموقع</label><div id="cvSite">—</div></div>
        <div><label>إجمالي التعامل</label><div id="cvTotal" style="font-family:'Readex Pro';color:var(--brand)">—</div></div>
      </div>
      <div class="row" style="margin-top:14px">
        <button class="btn sm" id="cvNew">فاتورة جديدة له</button>
        <button class="btn sm ghost" id="cvQuote">عرض سعر جديد</button>
        <button class="btn sm ghost" id="cvCall">اتصال</button>
        <button class="btn sm ghost" id="cvWa">واتساب</button>
      </div>
    </div>
    <div class="sectitle">فواتيره</div>
    <div id="cvList"></div>
  </section>

  <!-- ============ الإعدادات ============ -->
  <section id="viewSettings" class="hide">
    <div class="card">
      <h2>بيانات المنشأة</h2>
      <div class="grid g2">
        <div><label for="stName">الاسم النظامي (يظهر في الفاتورة)</label><input id="stName"></div>
        <div><label for="stPhone">رقم التواصل</label><input id="stPhone" class="ltr"></div>
      </div>
      <div class="grid g2" style="margin-top:12px">
        <div><label for="stMail">البريد</label><input id="stMail" class="ltr"></div>
        <div><label for="stCity">العنوان</label><input id="stCity"></div>
      </div>
    </div>

    <div class="card">
      <h2>الأرقام النظامية</h2>
      <div class="setrow">
        <div class="txt"><b>الرقم الضريبي</b><small>يُطبع أعلى الفاتورة عند تفعيله</small>
          <input id="stVatNo" class="ltr" style="margin-top:8px"></div>
        <button class="sw" id="swVat" data-k="showVat" aria-pressed="true"><i></i></button>
      </div>
      <div class="setrow">
        <div class="txt"><b>رقم السجل التجاري</b><small>الرقم الموحد للسجل التجاري</small>
          <input id="stCrNo" class="ltr" style="margin-top:8px"></div>
        <button class="sw" id="swCr" data-k="showCr" aria-pressed="true"><i></i></button>
      </div>
      <p class="note" style="margin-top:14px">إخفاء أي رقم ما يمسحه — يبقى محفوظًا هنا وترجّعه بضغطة وقت ما تبي.</p>
    </div>

    <div class="card">
      <h2>ضريبة القيمة المضافة</h2>
      <div class="setrow">
        <div class="txt"><b>احتساب ضريبة ١٥٪</b>
          <small>تُضاف للمجموع وتظهر كسطر مستقل، وتتحوّل الفاتورة إلى «فاتورة ضريبية مبسطة».</small></div>
        <button class="sw" id="swVatCalc" data-k="vatEnabled" aria-pressed="false"><i></i></button>
      </div>
      <p class="note" style="margin-top:14px">الفواتير المحفوظة سابقًا ما تتغيّر — كل فاتورة تحتفظ بحالتها وقت حفظها.</p>
    </div>

    <div class="card">
      <h2>نسخة احتياطية</h2>
      <div class="row">
        <button class="btn sm ghost" id="expBtn">تصدير ملف نسخة</button>
        <button class="btn sm ghost" id="impBtn">استيراد نسخة</button>
        <input type="file" id="impFile" accept="application/json" class="hide">
      </div>
      <p class="note" style="margin-top:14px">البيانات محفوظة داخل هذا الجهاز فقط. صدّر نسخة بين فترة وأخرى أو قبل تغيير الجوال.</p>
    </div>
  </section>

  <!-- ============ نموذج الفاتورة ============ -->
  <section id="viewForm" class="hide">
    <div class="card">
